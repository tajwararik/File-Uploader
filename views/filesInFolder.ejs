<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Files</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>

  <body>
    <header>
      <h1>Secret club</h1>
      <div>
        <a href="/">Back</a>
      </div>
    </header>

    <% folder.forEach(folder => { %>
    <section>
      <p>
        <a href="/folders/<%= folder.id %>/upload-file">Upload</a> new file.
      </p>
    </section>
    <% }) %>
  </body>
</html>
