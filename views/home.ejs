<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Home</title>
    <link rel="stylesheet" href="styles.css" />
  </head>

  <body>
    <header>
      <h1>Secret club</h1>
      <div>
        <a href="logout">Log out</a>
      </div>
    </header>

    <section>
      <p>Hello, <%= `${userObj.firstName} ${userObj.lastName}` %>!</p>
      <p>
        <a href="upload-file">Upload</a> new file or
        <a href="create-folder">create</a> folder.
      </p>
    </section>

    <section class="files">
      <h4>Your files</h4>

      <% if(!userFiles.length) { %>
      <p>You don't have any file.</p>
      <% } %>

      <ol>
        <% userFiles.forEach(file => { %>
        <li>
          <p><%= file.fileName %></p>
          <p>
            <strong>Size</strong>: <%= (file.size / 1024 ** 2).toFixed(2) %> MB
          </p>
          <p><strong>Created at</strong>: <%= file.formattedDate %></p>
          <a href="/<%= file.path %>" target="_blank">Download</a> |
          <form
            action="/file/<%= file.id %>/delete"
            method="post"
            style="display: inline; padding: 0"
          >
            <button
              type="submit"
              class="delete"
              onclick="confirm('Do you want to delete <%= file.fileName%>?')"
            >
              Delete
            </button>
          </form>
        </li>
        <% }) %>
      </ol>
    </section>

    <section class="folders">
      <h4>Your folders</h4>

      <% if(!userFolders.length) { %>
      <p>You don't have any folder.</p>
      <% } %>

      <ul>
        <% userFolders.forEach(folder => { %>
        <li>
          <a href="/folders/<%= folder.id %>"><%= folder.name %></a> |
          <form
            action="/folder/<%= folder.id %>/delete"
            method="post"
            style="display: inline; padding: 0"
          >
            <button
              type="submit"
              class="delete"
              onclick="confirm('Do you want to delete <%= folder.name%>?')"
            >
              Delete
            </button>
          </form>
        </li>
        <% }) %>
      </ul>
    </section>
  </body>
</html>
